# T05 - Secret And Config Separation
#
# Names only. This file is committed on purpose so the required configuration is
# discoverable; it must never contain a real value. Real `.env` files stay
# ignored by .gitignore.
#
# The split below is the whole point of this task:
#
#   PUBLIC   - safe to reach the browser. Anything prefixed VITE_ is inlined
#              into the client bundle by Vite at build time and is therefore
#              readable by every visitor. Only put values here that you would
#              be happy printing on the page.
#
#   PRIVATE  - consumed only by GitHub Actions / deploy logic. Stored as
#              GitHub Secrets, never as VITE_*, never committed, never echoed.
#              GitHub masks these in workflow logs.

# ---------------------------------------------------------------------------
# PUBLIC - repository variables, safe in the client bundle
# ---------------------------------------------------------------------------

# Human-readable label for the current deployment, shown in /status.
PUBLIC_DEPLOY_LABEL=<team-visible-label>

# Public address of the deployed site. Not a credential.
PUBLIC_URL=<https://your-assigned-domain-or-http-ip>
IP_PUBLIC_URL=<http://your-vps-ip>
DOMAIN_PUBLIC_URL=<https://your-assigned-domain>

# Non-sensitive deployment metadata.
APP_PORT=<port>
DEPLOY_PATH=<absolute-path-on-vps>
ASSIGNED_DOMAIN=<your-assigned-domain>
DNS_RECORD_TYPE=<A-or-CNAME>
DNS_RECORD_NAME=<record-label>
DNS_RECORD_VALUE=<origin-ip-or-host>

# ---------------------------------------------------------------------------
# PRIVATE - GitHub Secrets only. Never prefix these with VITE_.
# ---------------------------------------------------------------------------

# Deploy-time token used only inside Actions.
PRIVATE_DEPLOY_TOKEN=<set-as-a-github-secret>

# Token the deploy workflow uses to ask the organizer deployer to publish.
DEPLOYER_DISPATCH_TOKEN=<set-as-a-github-secret>

# DNS portal login and challenge token used only by DNS automation.
DNS_PORTAL_USERNAME=<set-as-a-github-secret>
DNS_PORTAL_PASSWORD=<set-as-a-github-secret>
DNS_TXT_VALUE=<set-as-a-github-secret>

# ---------------------------------------------------------------------------
# T22 - Compose runtime service
# ---------------------------------------------------------------------------
#
# The real runtime file is NOT this one. `compose.yml` reads a `.env` that is
# generated on the host at deploy time by scripts/generate-runtime-env.sh, from
# GitHub Secrets, with mode 0600. That file is gitignored and must never be
# committed - this section only documents which names it contains.
#
# To change a runtime value: update the GitHub Secret or variable, re-run the
# deploy so the file is regenerated, and `docker compose up -d`. Never edit the
# generated file in place on the server - the next deploy would overwrite it and
# the change would vanish with no record of who made it or why.

# Service identity. Public, not credentials.
SERVICE_NAME=<compose-service-and-container-name>
COMPOSE_PROJECT_NAME=<compose-project-name>

# Host port published to the VPS; the container always listens on 8080.
APP_PORT=8080

# Pinned to a commit SHA by the deploy. Never a moving tag such as `latest`.
IMAGE_TAG=<image-name>:<commit-sha>
GIT_COMMIT=<commit-sha>

# Absolute path of the generated runtime env file on the VPS.
RUNTIME_ENV_PATH=<absolute-path-on-vps>/.env
